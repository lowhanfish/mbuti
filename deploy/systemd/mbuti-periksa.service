[Unit]
Description=MBUTI pemeriksaan kesehatan
After=network-online.target

[Service]
Type=oneshot
User=mbuti
Group=mbuti
WorkingDirectory=/opt/mbuti/server
ExecStart=/opt/mbuti/server/.venv/bin/python -m scripts.periksa --cadangan /var/backups/mbuti
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mbuti
