[Unit]
Description=MBUTI penjadwal
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
User=mbuti
Group=mbuti
WorkingDirectory=/opt/mbuti/server
ExecStart=/opt/mbuti/server/.venv/bin/celery -A app.workers.celery_app beat --schedule /var/lib/mbuti/celerybeat-schedule --loglevel=info
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mbuti

[Install]
WantedBy=multi-user.target
