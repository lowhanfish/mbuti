[Unit]
Description=MBUTI cadangan harian
After=network-online.target

[Service]
Type=oneshot
User=mbuti
Group=mbuti
WorkingDirectory=/opt/mbuti/server
ExecStart=/opt/mbuti/server/.venv/bin/python -m scripts.cadangan buat --tujuan /var/backups/mbuti --simpan 14
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/mbuti
