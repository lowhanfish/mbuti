# Salin ke /opt/mbuti/server/.env (pemilik mbuti, chmod 600), lalu isi.
# Daftar lengkap pengaturan ada di server/.env.example.

APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL dengan ekstensi pgvector. Karakter khusus pada sandi di-percent-encode.
DATABASE_URL=

# Redis di mesin yang sama
REDIS_URL=redis://127.0.0.1:6379/1

# Wajib, minimal 32 karakter:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
COOKIE_SECURE=true
# Wajib. Kunci brankas dan verifikasi dua langkah, 32 byte base64:
#   python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Simpan salinannya terpisah dari cadangan database: tanpa kunci ini isi brankas tidak bisa dibuka.
VAULT_KEY=
# Ganti dengan alamat aplikasi, tanpa garis miring di akhir
ALLOWED_ORIGINS=["https://mbuti.contoh.go.id"]

UPLOAD_DIR=/var/lib/mbuti/uploads

# Kunci Gemini. Pada tier gratis, isi dokumen dapat dipakai Google: jangan untuk data rahasia.
GEMINI_API_KEY=
# GEMINI_API_KEY1=

# Akun mandiri. approval: organisasi baru disetujui lewat  python -m scripts.setujui_organisasi <slug>
REGISTRATION_MODE=approval
# Alamat aplikasi untuk tautan di email, tanpa garis miring di akhir
APP_URL=https://mbuti.contoh.go.id
# Email verifikasi, undangan, dan atur ulang kata sandi. console hanya menulis ke log.
EMAIL_BACKEND=smtp
EMAIL_FROM=MBUTI <no-reply@mbuti.contoh.go.id>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Pemberitahuan pemeriksaan tiap 5 menit (mbuti-periksa.timer): saat gagal, tiap 6 jam selama
# masih gagal, dan saat pulih. Dikirim langsung lewat SMTP di atas.
ALERT_EMAILS=
ALERT_STATE_FILE=/var/lib/mbuti/periksa-status.json
