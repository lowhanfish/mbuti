# Salin ke /opt/mbuti/server/.env (pemilik mbuti, chmod 600), lalu isi.
# Daftar lengkap pengaturan ada di server/.env.example.

APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL dengan ekstensi pgvector. Karakter khusus pada sandi di-percent-encode.
DATABASE_URL=

# Redis di mesin yang sama
REDIS_URL=redis://127.0.0.1:6379/1

# Wajib, minimal 32 karakter:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
COOKIE_SECURE=true
# Ganti dengan alamat aplikasi, tanpa garis miring di akhir
ALLOWED_ORIGINS=["https://mbuti.contoh.go.id"]

UPLOAD_DIR=/var/lib/mbuti/uploads

# Kunci Gemini. Pada tier gratis, isi dokumen dapat dipakai Google: jangan untuk data rahasia.
GEMINI_API_KEY=
# GEMINI_API_KEY1=
