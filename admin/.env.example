# Alamat backend FastAPI (dipakai saat NEXT_PUBLIC_DATA_SOURCE=api).
# Pakai nama host yang sama dengan aplikasi (localhost); bila berbeda, cookie sesi dan CSRF tidak berfungsi.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sumber data frontend:
#   mock -> data contoh di peramban (lib/mock), tanpa backend
#   api  -> backend FastAPI di NEXT_PUBLIC_API_URL
NEXT_PUBLIC_DATA_SOURCE=mock
