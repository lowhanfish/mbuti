# Salin menjadi server/.env lalu sesuaikan. Berkas .env tidak ikut git.
# Semua nilai di bawah adalah bawaan; baris boleh dihapus bila tidak diubah.

# ==========================
# APLIKASI
# ==========================
APP_NAME=MBUTI
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ==========================
# DATABASE (PostgreSQL + pgvector)
# ==========================
# Pilih salah satu cara. DATABASE_URL, bila diisi, mengalahkan DB_HOST s.d. DB_PASSWORD.
# Karakter khusus pada kata sandi di URL harus di-percent-encode (mis. @ menjadi %40).
# DATABASE_URL=postgresql://pengguna:sandi@127.0.0.1:5432/mbuti
DATABASE_URL=
# Database untuk pytest, di server yang sama. Harus berakhiran _test.
TEST_DB_NAME=mbuti_test
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mbuti
# Kosong berarti memakai nama pengguna sistem operasi.
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_ECHO=false

# ==========================
# REDIS DAN CELERY
# ==========================
REDIS_URL=redis://127.0.0.1:6379/1
# Kosong berarti sama dengan REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ==========================
# CORS
# ==========================
# Larik JSON atau daftar dipisah koma. Tidak boleh '*' karena permintaan membawa cookie.
ALLOWED_ORIGINS=["http://localhost:3000"]

# ==========================
# MODEL AI (dipakai mulai tahap B3 dan B4, lihat PLANNING.md bagian 7)
# ==========================
# Kunci tambahan untuk rotasi: GEMINI_API_KEY1, GEMINI_API_KEY2, ...
# GEMINI_API_KEY=
# LLM_MODEL_FAST=
# LLM_MODEL_BALANCED=
# LLM_MODEL_THOROUGH=
# LLM_FALLBACK_MODEL=
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSION=768
