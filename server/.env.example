# Salin menjadi server/.env lalu sesuaikan. Berkas .env tidak ikut git.
# Semua nilai di bawah adalah bawaan; baris boleh dihapus bila tidak diubah.

# ==========================
# APLIKASI
# ==========================
APP_NAME=MBUTI
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ==========================
# DATABASE (PostgreSQL + pgvector)
# ==========================
# Pilih salah satu cara. DATABASE_URL, bila diisi, mengalahkan DB_HOST s.d. DB_PASSWORD.
# Karakter khusus pada kata sandi di URL harus di-percent-encode (mis. @ menjadi %40).
# DATABASE_URL=postgresql://pengguna:sandi@127.0.0.1:5432/mbuti
DATABASE_URL=
# Database untuk pytest, di server yang sama. Harus berakhiran _test.
TEST_DB_NAME=mbuti_test
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mbuti
# Kosong berarti memakai nama pengguna sistem operasi.
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_ECHO=false

# ==========================
# REDIS DAN CELERY
# ==========================
REDIS_URL=redis://127.0.0.1:6379/1
# Kosong berarti sama dengan REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ==========================
# BRANKAS DAN VERIFIKASI DUA LANGKAH
# ==========================
# Kunci enkripsi 32 byte base64. Wajib di produksi. Buat dengan:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Kosong di pengembangan: dibuat sekali di server/.vault-key (tidak masuk git).
# Bila kunci hilang atau berubah, isi brankas dan verifikasi dua langkah tidak bisa dibuka.
VAULT_KEY=

# ==========================
# APLIKASI LUAR (E4b)
# ==========================
# Sekali setelah memasang pustaka:  playwright install --only-shell chromium
# Jalankan worker-nya:  celery -A app.workers.celery_app worker -Q browser --concurrency=1 -n browser@%h
# BROWSER_HEADLESS=true
# Matikan hanya bila server tidak mendukung kotak pasir Chromium
# BROWSER_SANDBOX=true
# BROWSER_ACTION_DELAY_MS=600
# BROWSER_TIMEOUT_MS=15000
# BROWSER_LEARN_MAX_STEPS=20
# BROWSER_OTP_WAIT_SECONDS=300

# ==========================
# SESI MASUK
# ==========================
# Wajib di produksi (minimal 32 karakter). Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Kosong di pengembangan: dibuat acak tiap aplikasi menyala.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Harus true di produksi (HTTPS)
COOKIE_SECURE=false
LOGIN_LIMIT_PER_MINUTE=20
LOGIN_FAILURE_LIMIT=5
# Kode verifikasi dua langkah yang salah per 5 menit untuk satu akun
TWO_FACTOR_FAILURE_LIMIT=5
# Batas laju per menit per pengguna untuk tindakan yang mahal
# RATE_TRIAL_PER_MINUTE=10
# RATE_FORMATION_PER_MINUTE=10
# RATE_ATTACHMENT_PER_MINUTE=30
# RATE_PROPOSAL_PER_MINUTE=20
# RATE_SCHEDULE_PARSE_PER_MINUTE=10
# RATE_LETTER_CORRECTION_PER_MINUTE=10
# Surat: lokasi soffice (kosong = dicari otomatis) dan batas waktu membuat PDF
# LIBREOFFICE_PATH=
# DOCUMENT_CONVERT_TIMEOUT_SECONDS=60
# RATE_UPLOAD_PER_MINUTE=20
# RATE_TASK_PER_MINUTE=20
# RATE_SEARCH_PER_MINUTE=60
# RATE_REFRESH_PER_MINUTE=60
# Per jam: pendaftaran per alamat, permintaan email per email dan per alamat, buka tautan per alamat
# RATE_REGISTER_PER_HOUR=5
# RATE_EMAIL_PER_HOUR=3
# RATE_EMAIL_PER_HOUR_PER_IP=10
# RATE_LINK_PER_HOUR=30

# ==========================
# AKUN MANDIRI DAN EMAIL
# ==========================
# closed | approval | open. approval: organisasi baru menunggu
#   python -m scripts.setujui_organisasi <slug>
REGISTRATION_MODE=approval
# Alamat frontend untuk tautan di email
APP_URL=http://localhost:3000
# console: isi email dan tautannya ditulis ke log worker (pengembangan); smtp: dikirim sungguhan
EMAIL_BACKEND=console
# EMAIL_FROM=MBUTI <no-reply@mbuti.local>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# ==========================
# PEMBERITAHUAN PEMANTAUAN (python -m scripts.periksa)
# ==========================
# Email saat ada pemeriksaan GAGAL, pengingat selama masih gagal, dan saat pulih. Dipisah koma.
# ALERT_EMAILS=pengelola@instansi.go.id
# ALERT_REMIND_HOURS=6
# ALERT_STATE_FILE=.periksa-status.json

# ==========================
# CORS
# ==========================
# Larik JSON atau daftar dipisah koma. Tidak boleh '*' karena permintaan membawa cookie.
ALLOWED_ORIGINS=["http://localhost:3000"]

# ==========================
# UNGGAHAN
# ==========================
# Bawaan: server/uploads (tidak ikut git)
# UPLOAD_DIR=
MAX_UPLOAD_BYTES=20971520

# ==========================
# MODEL AI (lihat PLANNING.md bagian 7)
# ==========================
# Kunci tambahan untuk rotasi: GEMINI_API_KEY1, GEMINI_API_KEY2, ...
# GEMINI_API_KEY=
# LLM_MODEL_FAST=gemini-3.1-flash-lite
# LLM_MODEL_BALANCED=gemini-3.5-flash-lite
# LLM_MODEL_THOROUGH=gemini-4-hydrogen
# LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
# LLM_PROVIDER=gemini
# GENERATION_TIMEOUT_SECONDS=60
# Kurs untuk menghitung biaya rupiah dari harga dolar
# USD_IDR_RATE=18000
# RETRIEVAL_MAX_DISTANCE=0.55
# gemini, atau mock (vektor tiruan tanpa memanggil Google; hanya untuk pengujian)
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSION=768
# Jarak kosinus maksimum agar potongan dianggap berkaitan
# SEARCH_MAX_DISTANCE=0.42
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_KEY_COOLDOWN_SECONDS=60

# ==========================
# PEMBENTUKAN ROLE (E1a)
# ==========================
# Batas putaran tanya jawab sebelum role harus di-Final
# FORMATION_ROUNDS_MAX=6

# ==========================
# GAMBAR (E1c)
# ==========================
# Gambar pengetahuan dan lampiran tugas (byte), halaman berat per berkas yang dibuat embedding
# gambarnya, gambar per langkah, lampiran per tugas, dan halaman PDF lampiran yang dibaca
# MAX_IMAGE_BYTES=10485760
# VISION_PAGES_PER_DOCUMENT=40
# MAX_IMAGES_PER_STEP=6
# MAX_ATTACHMENTS=10
# MAX_ATTACHMENT_PAGES=20

# ==========================
# PENCARIAN INTERNET (E1d)
# ==========================
# Batas pencarian Google bawaan Gemini per organisasi per hari
# WEB_SEARCH_PER_DAY=50
# Pencarian gratis tanpa kunci API; Gemini Google Search dipakai bila tidak ada hasil
# WEB_SEARCH_FREE=true
# WEB_SEARCH_BACKENDS=yahoo,auto
# WEB_SEARCH_PROVIDER_FALLBACK=true
# WEB_SEARCH_TIMEOUT_SECONDS=25
